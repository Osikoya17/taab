# Server-only settings. Copy to .env.server.local. Never use EXPO_PUBLIC_ for secrets.
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:8081,http://localhost:8082
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
HOST=127.0.0.1
PORT=3001
# Set to 1 only when running behind exactly one reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
DATABASE_PATH=.data/taab.sqlite
EXPO_ACCESS_TOKEN=

# Packs. See README → Packs. Leave unset to keep each part switched off.
# Scans per pack (1-1000). Not decided yet: packs show "Coming soon" until set.
RECEIPT_PACK_SCANS=
TRIP_PACK_SCANS=
# Real web checkout. The callback is the web app's Extras page.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://taab.expo.app/extras
# Real receipt scanning.
ANTHROPIC_API_KEY=
# Development only: simulated checkout and sample scans. Refused when NODE_ENV=production.
DEMO_PACKS=0
# For browser invite links, set this to your deployed app origin followed by /join.
EXPO_PUBLIC_INVITE_BASE_URL=taab://join
