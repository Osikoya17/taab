{
  "expo": {
    "name": "taab",
    "slug": "taab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taab",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F5",
    "ios": {
      "bundleIdentifier": "app.taab.mobile",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.taab.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "taab uses Face ID so only you can open your taabs."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#111111"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "taab uses your photos to attach receipts and set your profile picture.",
          "cameraPermission": "taab uses your camera to snap receipts."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "taab uses your contacts so you can invite friends to a taab."
        }
      ],
      "expo-sharing",
      "./plugins/with-bank-app-queries.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70ba519b-cae0-4922-9cb6-ed99bacdf46e"
      }
    },
    "owner": "ranmi"
  }
}
