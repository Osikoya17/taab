{
  "expo": {
    "name": "taab",
    "slug": "taab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taab",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F7F5",
    "ios": {
      "bundleIdentifier": "app.taab.mobile",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.taab.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 132
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#111111"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "taab uses your photos to attach receipts and set your profile picture.",
          "cameraPermission": "taab uses your camera to snap receipts."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "taab uses your contacts so you can invite friends to a taab."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
