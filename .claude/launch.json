{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "taab-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081,
      "autoPort": false,
      "env": { "BROWSER": "none", "EXPO_NO_TELEMETRY": "1" }
    },
    {
      "name": "taab-web-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8083"],
      "port": 8083,
      "env": {
        "BROWSER": "none",
        "EXPO_NO_TELEMETRY": "1",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "",
        "EXPO_PUBLIC_API_URL": "",
        "EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN": ""
      }
    },
    {
      "name": "taab-website",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../taab-website", "run", "dev", "--", "--port", "4321"],
      "port": 4321
    }
  ]
}
