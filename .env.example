# Leave both blank to use local demo mode.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_INVITE_BASE_URL=taab://join
EXPO_PUBLIC_DEFAULT_CURRENCY=NGN
EXPO_PUBLIC_SUPPORT_EMAIL=hello@taab.app
# Set to true after enabling Apple in the Clerk Dashboard (iOS only).
EXPO_PUBLIC_APPLE_SIGN_IN=false

# Optional PostHog analytics. Leave the token blank to disable.
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
